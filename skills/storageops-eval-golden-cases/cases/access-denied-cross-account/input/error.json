{
  "principal": "arn:aws:iam::111111111111:user/alice",
  "action": "s3:GetObject",
  "resource": "arn:aws:s3:::shared-data-bucket/reports/q4.pdf",
  "iam_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": ["s3:ListAllMyBuckets"],
        "Resource": "*"
      }
    ]
  },
  "bucket_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {"AWS": "arn:aws:iam::111111111111:root"},
        "Action": ["s3:GetObject"],
        "Resource": ["arn:aws:s3:::shared-data-bucket/*"]
      }
    ]
  }
}
